{
  "manifest_version": 3,
  "name": "X Article MD Import",
  "version": "0.2.0",
  "description": "Import a Markdown file into the X Articles editor. Tables, code blocks and images become native X blocks.",
  "permissions": [],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["lib/marked.min.js", "src/parser.js", "src/images.js", "src/editor.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
